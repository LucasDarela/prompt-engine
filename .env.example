# Copie para .env e preencha. NUNCA commite o .env.
# Referência completa: docs/plans/IMPLEMENTATION_PLAN.md (Apêndice A)

# --- App / API ---------------------------------------------------------------
APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO
LOG_FORMAT=console               # console | json
API_KEY=                         # se preenchida, exige header X-API-Key
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
DEBUG_ENDPOINTS=false            # habilita /api/v1/traces e include_debug
MAX_INPUT_CHARS=4000

# --- LLM ---------------------------------------------------------------------
LLM_PROVIDER=gemini              # gemini | fake (modo demo offline, respostas fixas)
LLM_FALLBACK_PROVIDERS=          # outros providers quando existirem adapters (Fase 8)
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_MODEL_FALLBACK=true          # modelo em 503? tenta outros modelos do mesmo provider

# Modelos Gemini validados em 2026-10-14 no plano gratuito (SPEC-006 §3.1)
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_BALANCED=gemini-3.7-flash
GEMINI_MODEL_POWERFUL=gemini-3.8-flash

# Adapters da Anthropic e da OpenAI estão ADIADOS (plano, Fase 8): só o Gemini funciona hoje.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# ANTHROPIC_MODEL_BALANCED=claude-sonnet-5-5
# ANTHROPIC_MODEL_POWERFUL=claude-opus-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL_FAST=
# OPENAI_MODEL_BALANCED=
# OPENAI_MODEL_POWERFUL=

# --- Pipeline ----------------------------------------------------------------
ENABLE_REVIEW_STEP=true          # false economiza 1 chamada por request
INJECTION_LOW=0.3
INJECTION_HIGH=0.8
INJECTION_JUDGE_ENABLED=true
PII_REHYDRATE_REPLY=true
CONFIDENCE_MIN=0.6
OUTPUT_MAX_REPAIRS=1

# --- Enriquecimento ----------------------------------------------------------
KB_PATH=data/knowledge_base
KB_INCLUDE_UNREVIEWED=false     # true só para inspecionar snippets gerados
SLA_PATH=data/sla.yaml
KB_TOP_K=3
KB_MIN_SCORE=0.1
KB_MIN_RELATIVE_SCORE=0.3        # corta snippets com score < 30% do melhor
KB_MAX_CHARS=2000

# --- Roteamento --------------------------------------------------------------
ROUTER_T1=0.35
ROUTER_T2=0.7
ROUTER_FORCE_TIER=               # fast | balanced | powerful (vazio = automático)

# --- Observabilidade ---------------------------------------------------------
OBS_ENABLED=true
OBS_DB_PATH=var/traces.db
OBS_STORE_RAW_INPUT=false        # LGPD: mantenha false
OBS_RETENTION_DAYS=30

# --- Evals -------------------------------------------------------------------
EVAL_CONCURRENCY=2
EVAL_DELAY_S=1.0
